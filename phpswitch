#!/bin/bash
# ╔══════════════════════════════════════════════════════╗
# ║  phpswitch — Easy PHP Version Switcher for Ubuntu   ║
# ║  Supports: Apache2 mod_php, PHP-FPM, Nginx, CLI     ║
# ║  Author  : afiez (github.com/afiez97)               ║
# ║  License : MIT                                       ║
# ╚══════════════════════════════════════════════════════╝

# ── Colors ──────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
MAGENTA='\033[0;35m'
BOLD='\033[1m'
DIM='\033[2m'
NC='\033[0m'

# ── Overridable path roots (defaults match a stock Ubuntu box; tests point
#    these at a fake root instead) ──────────────────────────────────────
PHP_BIN_DIR="${PHP_BIN_DIR:-/usr/bin}"
APACHE_MODS_AVAILABLE="${APACHE_MODS_AVAILABLE:-/etc/apache2/mods-available}"
APACHE_MODS_ENABLED="${APACHE_MODS_ENABLED:-/etc/apache2/mods-enabled}"
NGINX_SITES_ENABLED="${NGINX_SITES_ENABLED:-/etc/nginx/sites-enabled}"
NGINX_CONF_D="${NGINX_CONF_D:-/etc/nginx/conf.d}"
FPM_SOCK_DIR="${FPM_SOCK_DIR:-/run/php}"

# Set to 1 by a `--dry-run` flag anywhere in argv (see main()). When set, no
# mutating command is actually run — see would() below.
DRY_RUN=0

# ── Helpers ──────────────────────────────────────────────

# Require root for any mutation operations (skipped entirely under
# --dry-run, since every dry-run code path is read-only).
check_root() {
    [[ "$DRY_RUN" -eq 1 ]] && return 0
    if [[ $EUID -ne 0 ]]; then
        echo -e "${RED}✗ This script must be run as root.${NC}"
        echo -e "  Try: ${CYAN}sudo phpswitch${NC}"
        exit 1
    fi
}

ok()   { echo -e "  ${GREEN}✓${NC} $*"; }
info() { echo -e "  ${CYAN}→${NC} $*"; }
warn() { echo -e "  ${YELLOW}⚠${NC}  $*"; }
fail() { echo -e "  ${RED}✗${NC} $*"; }
would() { echo -e "  ${MAGENTA}[dry-run]${NC} would run: $*"; }
sep()  { echo -e "${DIM}──────────────────────────────────────────${NC}"; }

# ── Discovery ────────────────────────────────────────────

# Returns a space-separated, version-sorted list of installed PHP binaries
get_installed_versions() {
    local versions=()
    for v in "${PHP_BIN_DIR}"/php[0-9].[0-9] "${PHP_BIN_DIR}"/php[0-9].[0-9][0-9]; do
        [[ -x "$v" ]] && versions+=("$(basename "$v" | sed 's/php//')")
    done
    printf '%s\n' "${versions[@]}" | sort -V | tr '\n' ' '
}

# Returns the version currently pointed to by ${PHP_BIN_DIR}/php
get_current_cli() {
    readlink -f "${PHP_BIN_DIR}/php" 2>/dev/null | grep -oP '[0-9]+\.[0-9]+$' || \
    "${PHP_BIN_DIR}/php" --version 2>/dev/null | grep -oP 'PHP \K[0-9]+\.[0-9]+'
}

# Returns the PHP version currently active as Apache mod_php (or "none")
get_current_apache() {
    ls "${APACHE_MODS_ENABLED}"/php*.conf 2>/dev/null \
        | grep -oP 'php\K[0-9]+\.[0-9]+' | head -1 || echo "none"
}

# Returns newline-separated list of PHP-FPM versions that are currently active
get_active_fpm_versions() {
    systemctl list-units --type=service --state=active --no-legend 2>/dev/null \
        | awk '{print $1}' \
        | grep -oP '^php[0-9]+\.[0-9]+-fpm' \
        | grep -oP '[0-9]+\.[0-9]+' \
        | sort -V
}

# Check if Apache module is available for a given PHP version
has_apache_module() { [[ -f "${APACHE_MODS_AVAILABLE}/php${1}.conf" ]]; }

# Check if PHP-FPM systemd unit is available for a given PHP version
has_fpm()           { systemctl list-unit-files 2>/dev/null | grep -q "php${1}-fpm.service"; }

# Silently test if services are running
apache_running()    { systemctl is-active --quiet apache2 2>/dev/null; }
nginx_running()     { systemctl is-active --quiet nginx 2>/dev/null; }

# ── Status display ───────────────────────────────────────
show_status() {
    local cli_ver apache_ver active_fpm
    cli_ver=$(get_current_cli)
    apache_ver=$(get_current_apache)
    active_fpm=$(get_active_fpm_versions)

    echo ""
    echo -e "${BOLD}${BLUE}  PHP Version Status${NC}"
    sep

    # CLI
    echo -e "  ${BOLD}CLI      ${NC} PHP ${GREEN}${cli_ver}${NC}"

    # Apache
    if command -v apache2ctl &>/dev/null; then
        local ast
        ast=$(systemctl is-active apache2 2>/dev/null || echo "stopped")
        if [[ "$apache_ver" != "none" ]]; then
            echo -e "  ${BOLD}Apache   ${NC} mod_php${GREEN}${apache_ver}${NC}  (${ast})"
        else
            echo -e "  ${BOLD}Apache   ${NC} ${YELLOW}no PHP module active${NC}  (${ast})"
        fi
    fi

    # PHP-FPM (all active instances)
    if [[ -n "$active_fpm" ]]; then
        for fv in $active_fpm; do
            echo -e "  ${BOLD}PHP-FPM  ${NC} php${GREEN}${fv}${NC}-fpm  (active)"
        done
    else
        echo -e "  ${BOLD}PHP-FPM  ${NC} ${YELLOW}none active${NC}"
    fi

    # Nginx
    if command -v nginx &>/dev/null; then
        local nst
        nst=$(systemctl show nginx --property=ActiveState 2>/dev/null | cut -d= -f2)
        [[ -z "$nst" ]] && nst="unknown"
        echo -e "  ${BOLD}Nginx    ${NC} ${nst}"
    fi

    sep
    echo -e "  ${BOLD}Installed PHP versions:${NC}"
    for v in $(get_installed_versions); do
        local tags=""
        has_apache_module "$v" && tags+=" ${DIM}[apache]${NC}"
        has_fpm "$v"            && tags+=" ${DIM}[fpm]${NC}"
        local marker=""
        [[ "$v" == "$cli_ver" ]] && marker="  ${GREEN}← CLI${NC}"
        [[ "$v" == "$apache_ver" ]] && marker+="  ${BLUE}← Apache${NC}"
        echo -e "    ${CYAN}PHP ${v}${NC}${tags}${marker}"
    done
    echo ""
}

# ── Switch: CLI ──────────────────────────────────────────
switch_cli() {
    local ver="$1"

    if [[ "$DRY_RUN" -eq 1 ]]; then
        info "Would switch CLI to PHP ${ver}"
        would update-alternatives --set php "${PHP_BIN_DIR}/php${ver}"
        for cmd in phpize php-config phar phar.phar php-cgi; do
            local bin="${PHP_BIN_DIR}/${cmd}${ver}"
            if update-alternatives --list "$cmd" &>/dev/null && [[ -x "$bin" ]]; then
                would update-alternatives --set "$cmd" "$bin"
            fi
        done
        return 0
    fi

    info "Switching CLI to PHP ${ver}..."

    # Set the main php alternative
    if ! update-alternatives --set php "${PHP_BIN_DIR}/php${ver}" 2>/dev/null; then
        fail "Failed to set php alternative to ${ver}"
        return 1
    fi

    # Switch companion tools if they are registered as alternatives
    for cmd in phpize php-config phar phar.phar php-cgi; do
        local bin="${PHP_BIN_DIR}/${cmd}${ver}"
        if update-alternatives --list "$cmd" &>/dev/null && [[ -x "$bin" ]]; then
            update-alternatives --set "$cmd" "$bin" 2>/dev/null || true
        fi
    done

    ok "CLI → php$("${PHP_BIN_DIR}/php" --version 2>/dev/null | grep -oP 'PHP \K[0-9]+\.[0-9]+\.[0-9]+')"
    return 0
}

# ── Switch: Apache mod_php ───────────────────────────────
# Returns: 0 ok, 1 real failure, 2 intentionally skipped (not installed)
switch_apache() {
    local ver="$1"

    if ! command -v apache2ctl &>/dev/null; then
        warn "Apache not found, skipping."
        return 2
    fi

    if ! has_apache_module "$ver"; then
        warn "Apache mod for PHP ${ver} not installed."
        echo -e "       Install: ${CYAN}sudo apt install libapache2-mod-php${ver}${NC}"
        return 2
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        info "Would switch Apache to PHP ${ver}"
    else
        info "Switching Apache to PHP ${ver}..."
    fi

    # Disable all currently enabled php modules
    for mod_conf in "${APACHE_MODS_ENABLED}"/php*.conf; do
        [[ -f "$mod_conf" ]] || continue
        local modname
        modname=$(basename "$mod_conf" .conf)
        if [[ "$DRY_RUN" -eq 1 ]]; then
            would a2dismod "$modname" --force
        else
            a2dismod "$modname" --force 2>/dev/null && echo -e "     Disabled ${modname}" || true
        fi
    done

    if [[ "$DRY_RUN" -eq 1 ]]; then
        would a2enmod "php${ver}"
        would systemctl restart apache2
        return 0
    fi

    # Enable the requested version
    if ! a2enmod "php${ver}" 2>/dev/null; then
        fail "Failed to enable mod_php${ver}"
        return 1
    fi
    if ! systemctl restart apache2; then
        fail "Failed to restart apache2"
        return 1
    fi
    ok "Apache → mod_php${ver} enabled, apache2 restarted"
    return 0
}

# ── Switch: PHP-FPM ──────────────────────────────────────
# Returns: 0 ok, 1 real failure, 2 intentionally skipped (not installed)
# Also sets the global NGINX_STATUS to one of ok/failed/skipped/"" (nginx is
# tracked separately since a pre-existing broken nginx config shouldn't turn
# an otherwise-successful FPM switch into a reported failure).
switch_fpm() {
    local ver="$1"
    NGINX_STATUS=""

    if ! systemctl list-unit-files 2>/dev/null | grep -q 'php[0-9].*fpm'; then
        warn "No PHP-FPM services found, skipping."
        return 2
    fi

    if ! has_fpm "$ver"; then
        warn "PHP-FPM for version ${ver} not installed."
        echo -e "       Install: ${CYAN}sudo apt install php${ver}-fpm${NC}"
        return 2
    fi

    if [[ "$DRY_RUN" -eq 1 ]]; then
        info "Would switch PHP-FPM to php${ver}-fpm"
    else
        info "Switching PHP-FPM to php${ver}-fpm..."
    fi

    # Stop all other running FPM versions
    while IFS= read -r fpm_service; do
        local fpm_ver
        fpm_ver=$(echo "$fpm_service" | grep -oP '[0-9]+\.[0-9]+')
        if [[ "$fpm_ver" != "$ver" ]]; then
            if systemctl is-active --quiet "$fpm_service" 2>/dev/null; then
                if [[ "$DRY_RUN" -eq 1 ]]; then
                    would systemctl stop "$fpm_service"
                else
                    systemctl stop "$fpm_service" 2>/dev/null && \
                        echo -e "     Stopped ${fpm_service}" || true
                fi
            fi
        fi
    done < <(systemctl list-unit-files --type=service --no-legend 2>/dev/null \
             | awk '{print $1}' | grep 'php[0-9]\+\.[0-9]\+-fpm')

    if [[ "$DRY_RUN" -eq 1 ]]; then
        would systemctl enable "php${ver}-fpm"
        would systemctl restart "php${ver}-fpm"
        # update_nginx_fpm_socket is dry-run aware itself (see below), so it
        # can be called unconditionally here.
        update_nginx_fpm_socket "$ver"
        if nginx_running; then
            would nginx -t "&&" systemctl reload nginx
            NGINX_STATUS="ok"
        else
            NGINX_STATUS="skipped"
        fi
        return 0
    fi

    # Enable and start the target FPM
    systemctl enable "php${ver}-fpm" --quiet 2>/dev/null || true
    if ! systemctl restart "php${ver}-fpm"; then
        fail "Failed to restart php${ver}-fpm"
        return 1
    fi
    ok "PHP-FPM → php${ver}-fpm active"

    # Auto-update Nginx fastcgi_pass socket
    update_nginx_fpm_socket "$ver"

    # Reload Nginx if it is running
    if nginx_running; then
        info "Reloading Nginx..."
        if nginx -t 2>/dev/null; then
            if systemctl reload nginx; then
                ok "Nginx reloaded"
                NGINX_STATUS="ok"
            else
                warn "Nginx reload failed"
                NGINX_STATUS="failed"
            fi
        else
            warn "Nginx config test failed — skipping reload. Run: ${CYAN}sudo nginx -t${NC}"
            NGINX_STATUS="failed"
        fi
    else
        warn "Nginx not running (skipping reload)"
        NGINX_STATUS="skipped"
    fi

    return 0
}

# ── Nginx: update FPM socket path in sites-enabled ───────
update_nginx_fpm_socket() {
    local ver="$1"
    local new_socket="${FPM_SOCK_DIR}/php${ver}-fpm.sock"

    # Scan all enabled Nginx sites and conf.d files
    for site in "${NGINX_SITES_ENABLED}"/* "${NGINX_CONF_D}"/*.conf; do
        [[ -f "$site" ]] || continue
        if grep -qP "fastcgi_pass\s+unix:${FPM_SOCK_DIR}/php[0-9]+\.[0-9]+-fpm\.sock" "$site"; then
            local old_socket
            old_socket=$(grep -oP "unix:${FPM_SOCK_DIR}/php[0-9]+\.[0-9]+-fpm\.sock" "$site" | head -1)
            if [[ "$old_socket" != "unix:${new_socket}" ]]; then
                if [[ "$DRY_RUN" -eq 1 ]]; then
                    would "sed -i s|${old_socket}|unix:${new_socket}| ${site}"
                else
                    info "Updating Nginx socket in ${site##*/}: → php${ver}-fpm.sock"
                    sed -i "s|unix:${FPM_SOCK_DIR}/php[0-9]*\.[0-9]*-fpm\.sock|unix:${new_socket}|g" "$site"
                    ok "Nginx config updated"
                fi
            fi
        fi
    done
}

# ── Restart web servers only (no CLI/FPM version change) ─
restart_web_servers() {
    if command -v apache2ctl &>/dev/null; then
        if [[ "$DRY_RUN" -eq 1 ]]; then
            would systemctl restart apache2
        else
            info "Restarting Apache..."
            systemctl restart apache2 && ok "Apache restarted" || fail "Apache restart failed"
        fi
    fi
    if command -v nginx &>/dev/null; then
        if nginx_running; then
            if [[ "$DRY_RUN" -eq 1 ]]; then
                would nginx -t "&&" systemctl reload nginx
            else
                info "Reloading Nginx..."
                if nginx -t 2>/dev/null; then
                    systemctl reload nginx && ok "Nginx reloaded"
                else
                    warn "Nginx config test failed — skipping reload. Run: sudo nginx -t"
                fi
            fi
        fi
    fi
}

# ── Validation for desktop-app commands ──────────────────
validate_version_arg() {
    local ver="$1"
    if [[ ! "$ver" =~ ^[0-9]+\.[0-9]+$ ]]; then
        fail "Invalid version: ${ver}"
        exit 1
    fi
    if [[ ! -x "${PHP_BIN_DIR}/php${ver}" ]]; then
        fail "PHP ${ver} is not installed."
        exit 1
    fi
}

# ── JSON status (for the desktop app) ────────────────────
json_escape() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g'; }

print_json_status() {
    local cli_ver apache_ver active_fpm
    cli_ver=$(get_current_cli)
    apache_ver=$(get_current_apache)
    active_fpm=$(get_active_fpm_versions)

    local fpm_json="["
    local first=1
    for fv in $active_fpm; do
        [[ $first -eq 0 ]] && fpm_json+=","
        fpm_json+="\"$(json_escape "$fv")\""
        first=0
    done
    fpm_json+="]"

    local versions_json="["
    first=1
    for v in $(get_installed_versions); do
        [[ $first -eq 0 ]] && versions_json+=","
        local has_apache="false" has_fpm_v="false"
        has_apache_module "$v" && has_apache="true"
        has_fpm "$v" && has_fpm_v="true"
        versions_json+="{\"version\":\"$(json_escape "$v")\",\"path\":\"${PHP_BIN_DIR}/php$(json_escape "$v")\",\"hasApache\":${has_apache},\"hasFpm\":${has_fpm_v}}"
        first=0
    done
    versions_json+="]"

    printf '{"cli":"%s","apache":"%s","activeFpm":%s,"apacheRunning":%s,"nginxRunning":%s,"versions":%s}\n' \
        "$(json_escape "$cli_ver")" \
        "$(json_escape "$apache_ver")" \
        "$fpm_json" \
        "$(apache_running && echo true || echo false)" \
        "$(nginx_running && echo true || echo false)" \
        "$versions_json"
}

# ── Composer reminder ────────────────────────────────────
check_composer() {
    if command -v composer &>/dev/null; then
        local comp_php
        comp_php=$(composer --version 2>/dev/null | grep -oP 'PHP \K[0-9]+\.[0-9]+' || echo "?")
        echo -e "  ${DIM}Composer is using PHP ${comp_php} — open a new terminal to reflect CLI change.${NC}"
    fi
}

# ── Component status (0/1/2) → human label ───────────────
status_label() {
    case "$1" in
        0) echo -e "${GREEN}ok${NC}" ;;
        1) echo -e "${RED}failed${NC}" ;;
        2) echo -e "${DIM}skipped${NC}" ;;
        *) echo -e "${DIM}n/a${NC}" ;;
    esac
}

# ── Per-component summary block printed after a switch ───
print_switch_summary() {
    local ver="$1" cli_rc="$2" apache_rc="$3" fpm_rc="$4" nginx_status="$5"

    echo -e "${BOLD}  Summary${NC}"
    echo -e "    CLI      $(status_label "$cli_rc")"
    echo -e "    Apache   $(status_label "$apache_rc")"
    echo -e "    PHP-FPM  $(status_label "$fpm_rc")"
    case "$nginx_status" in
        ok)      echo -e "    Nginx    ${GREEN}ok${NC}" ;;
        failed)  echo -e "    Nginx    ${RED}failed${NC}" ;;
        skipped) echo -e "    Nginx    ${DIM}skipped${NC}" ;;
        *)       echo -e "    Nginx    ${DIM}n/a${NC}" ;;
    esac
    echo ""

    if [[ "$DRY_RUN" -eq 1 ]]; then
        echo -e "${BOLD}${MAGENTA}  Dry run only — no changes were made.${NC}"
    elif [[ "$cli_rc" -eq 1 || "$apache_rc" -eq 1 || "$fpm_rc" -eq 1 ]]; then
        echo -e "${BOLD}${RED}  Completed with errors — PHP ${ver} may not be fully active. See above.${NC}"
    else
        echo -e "${BOLD}${GREEN}  Done! PHP ${ver} is now active.${NC}"
    fi
}

# ── Core switch logic ────────────────────────────────────
switch_version() {
    local ver="$1"

    # Validate the requested version is actually installed
    if [[ ! -x "${PHP_BIN_DIR}/php${ver}" ]]; then
        fail "PHP ${ver} is not installed."
        echo ""
        echo -e "  Install it with:"
        echo -e "  ${CYAN}sudo add-apt-repository ppa:ondrej/php${NC}"
        echo -e "  ${CYAN}sudo apt update && sudo apt install php${ver}${NC}"
        exit 1
    fi

    echo ""
    echo -e "${BOLD}${BLUE}  Switching to PHP ${ver}${NC}"
    sep

    local cli_rc apache_rc fpm_rc
    switch_cli    "$ver"; cli_rc=$?
    switch_apache "$ver"; apache_rc=$?
    switch_fpm    "$ver"; fpm_rc=$?

    sep
    check_composer
    echo ""
    print_switch_summary "$ver" "$cli_rc" "$apache_rc" "$fpm_rc" "$NGINX_STATUS"
    echo ""
    show_status

    local overall_rc=0
    [[ "$cli_rc" -eq 1 || "$apache_rc" -eq 1 || "$fpm_rc" -eq 1 ]] && overall_rc=1
    exit "$overall_rc"
}

# ── Interactive menu ─────────────────────────────────────
interactive_menu() {
    show_status

    local versions
    read -ra versions <<< "$(get_installed_versions)"

    if [[ ${#versions[@]} -eq 0 ]]; then
        fail "No PHP versions found!"
        exit 1
    fi

    echo -e "${BOLD}  Switch to:${NC}"
    for i in "${!versions[@]}"; do
        local tags=""
        has_apache_module "${versions[$i]}" && tags+=" [apache]"
        has_fpm "${versions[$i]}"            && tags+=" [fpm]"
        echo -e "    ${CYAN}[${BOLD}$((i+1))${NC}${CYAN}]${NC}  PHP ${versions[$i]}${DIM}${tags}${NC}"
    done
    echo -e "    ${CYAN}[${BOLD}s${NC}${CYAN}]${NC}  Show status"
    echo -e "    ${CYAN}[${BOLD}q${NC}${CYAN}]${NC}  Quit"
    echo ""
    read -rp "  Choice: " choice

    case "$choice" in
        s|S) show_status ;;
        q|Q) echo "  Bye!"; exit 0 ;;
        [0-9]*)
            local idx=$((choice - 1))
            if [[ $idx -ge 0 && $idx -lt ${#versions[@]} ]]; then
                switch_version "${versions[$idx]}"
            else
                fail "Invalid choice: ${choice}"; exit 1
            fi
            ;;
        *)
            # Allow typing version directly (e.g. "8.3")
            if printf '%s\n' "${versions[@]}" | grep -qx "$choice"; then
                switch_version "$choice"
            else
                fail "Invalid choice: ${choice}"; exit 1
            fi
            ;;
    esac
}

# ── Help text ────────────────────────────────────────────
print_help() {
    echo -e "${BOLD}phpswitch${NC} — PHP version switcher for Ubuntu"
    echo -e "${DIM}  Supports Apache2, Nginx, PHP-FPM, CLI${NC}"
    echo ""
    echo -e "${BOLD}Usage:${NC}"
    echo -e "  ${CYAN}sudo phpswitch${NC}              Interactive menu"
    echo -e "  ${CYAN}sudo phpswitch 8.3${NC}          Switch all components to PHP 8.3"
    echo -e "  ${CYAN}sudo phpswitch 8.4${NC}          Switch all components to PHP 8.4"
    echo -e "  ${CYAN}phpswitch --status${NC}          Show current PHP status  (no root needed)"
    echo -e "  ${CYAN}phpswitch --json-status${NC}     Show current PHP status as JSON (no root needed)"
    echo -e "  ${CYAN}phpswitch 8.3 --dry-run${NC}     Preview a switch to PHP 8.3 — no changes made, no root needed"
    echo -e "  ${CYAN}phpswitch --help${NC}            Show this help"
    echo ""
    echo -e "${BOLD}What gets switched:${NC}"
    echo -e "  ${GREEN}•${NC} CLI          update-alternatives → /usr/bin/php<ver>"
    echo -e "  ${GREEN}•${NC} CLI tools    phpize, php-config, phar, php-cgi"
    echo -e "  ${GREEN}•${NC} Apache2      a2dismod old, a2enmod new, restart apache2"
    echo -e "  ${GREEN}•${NC} PHP-FPM      stop others, start php<ver>-fpm"
    echo -e "  ${GREEN}•${NC} Nginx socket auto-update fastcgi_pass in sites-enabled"
    echo -e "  ${GREEN}•${NC} Nginx        reload (after config test)"
    echo ""
    echo -e "${BOLD}Install new PHP versions:${NC}"
    echo -e "  ${CYAN}sudo add-apt-repository ppa:ondrej/php${NC}"
    echo -e "  ${CYAN}sudo apt install php8.5 php8.5-fpm libapache2-mod-php8.5${NC}"
    echo ""
}

# ── Entry point ──────────────────────────────────────────
main() {
    # Recognize --dry-run in any position and strip it out before dispatch,
    # so `phpswitch --dry-run 8.3`, `phpswitch 8.3 --dry-run`, and
    # `phpswitch --set-cli 8.3 --dry-run` all work the same way.
    local args=()
    for a in "$@"; do
        if [[ "$a" == "--dry-run" ]]; then
            DRY_RUN=1
        else
            args+=("$a")
        fi
    done
    set -- "${args[@]}"

    case "${1:-}" in
        --help|-h)
            print_help
            ;;
        --status|-s)
            show_status
            ;;
        --json-status)
            print_json_status
            ;;
        --set-cli)
            check_root
            validate_version_arg "$2"
            switch_cli "$2"
            ;;
        --set-apache)
            check_root
            validate_version_arg "$2"
            switch_apache "$2"
            # Translate switch_apache's 0/1/2 into a process exit code: an
            # intentional skip (2, e.g. "Apache not installed") must exit 0,
            # not 2 — otherwise a machine with no Apache would make the
            # desktop app's `run_privileged` see a nonzero exit and report a
            # false failure for something that was never an error.
            [[ $? -eq 1 ]] && exit 1
            exit 0
            ;;
        --set-fpm)
            check_root
            validate_version_arg "$2"
            switch_fpm "$2"
            # Same 1-only-fails translation as --set-apache above.
            [[ $? -eq 1 ]] && exit 1
            exit 0
            ;;
        --restart-services)
            check_root
            restart_web_servers
            ;;
        "")
            check_root
            interactive_menu
            ;;
        [0-9].[0-9]|[0-9].[0-9][0-9])
            check_root
            switch_version "$1"
            ;;
        *)
            fail "Unknown argument: $1"
            echo -e "  Run: ${CYAN}phpswitch --help${NC}"
            exit 1
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    main "$@"
fi
