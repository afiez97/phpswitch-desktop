#!/usr/bin/env bash
# Mock of nginx. `-t` (config test) is controllable per test via
# MOCK_NGINX_TEST_FAIL=1.

[[ -n "${MOCK_LOG:-}" ]] && echo "nginx $*" >> "$MOCK_LOG"

case "${1:-}" in
    -t)
        if [[ "${MOCK_NGINX_TEST_FAIL:-0}" == "1" ]]; then
            echo "nginx: configuration file test failed" >&2
            exit 1
        fi
        exit 0
        ;;
    *)
        exit 0
        ;;
esac
